# Claude API Keys (optional - 3-agent pipeline: Architect, Coder, Reviewer)
CLAUDE_API_KEY_1=sk-ant-your-first-claude-key-here
CLAUDE_API_KEY_2=sk-ant-your-second-claude-key-here
CLAUDE_API_KEY_3=sk-ant-your-third-claude-key-here

# OpenAI API Keys (optional - used as fallback if Claude is unavailable)
OPENAI_API_KEY_1=sk-your-first-openai-key-here
OPENAI_API_KEY_2=sk-your-second-openai-key-here

# Gemini API Keys (optional - used as final fallback)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your-first-gemini-key-here
GEMINI_API_KEY_2=your-second-gemini-key-here
GEMINI_API_KEY_3=your-third-gemini-key-here

# Session Secret (used to sign session cookies - set to any long random string)
SESSION_SECRET=replace-with-a-long-random-secret-string

# Notes:
# - At least ONE AI provider must be configured for code generation to work.
# - Priority order: Claude → OpenAI → Gemini
# - Never commit your real .env file to version control.
# - Copy this file to .env and fill in your actual keys.
